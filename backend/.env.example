PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
TESSERACT_CMD=/opt/homebrew/bin/tesseract

# Google Gemini API Key
GEMINI_API_KEY=

# Supabase Credentials (Optional - Leave empty to run in Local Demo Mode)
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=
SUPABASE_KEY=

# Telegram Bot Integration (Optional)
# Obtain your Bot Token by messaging @BotFather on Telegram (/newbot)
TELEGRAM_BOT_TOKEN=
# Optional default Chat ID (Start your bot in Telegram and send /start to see your Chat ID)
TELEGRAM_DEFAULT_CHAT_ID=
